# Copia este archivo a .env y complétalo con los datos de TU proyecto de Supabase
# (panel del proyecto → Settings → API). El archivo .env está en .gitignore.
#
# Ojo: en Vite todo lo que empieza con VITE_ termina dentro del bundle y es
# público. La clave anónima está diseñada para eso; lo que protege los datos
# es Row Level Security. La clave service_role NUNCA va acá.

VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
